# ---------------------------------------------------------------------------
# Luminary Automation — environment variables
# Copy to .env for local development. On Railway, set these as service variables.
# Leave a group blank to run that piece in clearly-labelled DEMO / SIMULATED mode.
# ---------------------------------------------------------------------------

# Server
PORT=8787
APP_URL=http://localhost:5173            # public URL of the app (used in invite emails)

# Database — Supabase Postgres connection string. Tables live in their own `automation` schema,
# so this can be the same Supabase project as Luminary Academy.
# Supabase dashboard > Connect > "Session pooler" (port 5432) or direct connection.
# Blank = in-process PGlite with sample data (resets on restart).
DATABASE_URL=
# PGLITE_DIR=./.data                     # optional: keep demo data between restarts
# SEED_DEMO=true                         # seed sample centers when using PGlite

# Auth — Supabase project (Project Settings > API).
# Both blank = DEMO sign-in (pick a sample user, no password). Never deploy real data that way.
# The service-role key is NOT needed: sessions are verified with the anon key, and staff invites
# are stored in the database and accepted when that person signs in with a verified email.
SUPABASE_URL=
SUPABASE_ANON_KEY=                       # public anon or publishable (sb_publishable_...) key; also sent to the browser

# AI — Anthropic API. Blank = simulated AI (rules-based classification + template drafts).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_INPUT_COST_PER_MTOK=0.10              # assumption used for cost estimates on the dashboard
AI_OUTPUT_COST_PER_MTOK=0.50

# Email — Resend (https://resend.com). Blank = simulated sending (nothing leaves the server).
RESEND_API_KEY=
EMAIL_FROM=                              # e.g. replies@mail.yourdomain.com (domain must be verified in Resend)

# Reminder engine
REMINDER_INTERVAL_MS=60000               # how often the in-process scheduler checks for due reminders
CRON_SECRET=                             # optional: enables POST /api/cron/reminders for an external scheduler

# Other sites allowed to send inquiries to /api/public/forms/<slug>/inquiries (comma-separated).
ALLOWED_ORIGINS=                         # e.g. https://theluminaryacademy.net,https://www.theluminaryacademy.net
